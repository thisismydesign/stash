# Copy to `.env` and fill in for production: builds, deploys and `E2E_BASE_URL` runs read it.
# Development reads `.env.development` (the local stack) instead. `.env` is gitignored.
#
# Supabase is self-hosted in a VM on the tailnet (https://github.com/thisismydesign/supabase-vm); its keys and
# database password are in `/opt/supabase/.env` inside the VM. A hosted project works too: see docs/deploy.md.
SUPABASE_URL=            # the instance's public URL, https://<vm>.<tailnet>.ts.net — server-side scripts and e2e
SUPABASE_SECRET_KEY=     # SUPABASE_SECRET_KEY in the VM (sb_secret_…) — server-side only, never shipped to a browser
VITE_SUPABASE_URL=       # same URL; read by the app at build time
VITE_SUPABASE_KEY=       # SUPABASE_PUBLISHABLE_KEY in the VM (sb_publishable_…) — safe to embed in the browser bundle
SUPABASE_DB_URL=         # postgresql://postgres.<tenant>:<POSTGRES_PASSWORD>@<vm>.<tailnet>.ts.net:5432/postgres?sslmode=disable — migrations; the tenant is POOLER_TENANT_ID in the VM, and its pooler speaks no TLS (the tailnet encrypts). Empty: deploy to the linked hosted project
STASH_VM_SSH_KEY_FILE=   # private key authorised for ubuntu in the VM; copies the function in. Empty: your own ssh config
STASH_TEST_EMAIL=        # the end-to-end test user; created on first run, never emailed
# CI joins the tailnet with a Tailscale OAuth client (tag:ci): TS_OAUTH_CLIENT_ID and TS_OAUTH_SECRET are
# repository secrets only, with the key above as STASH_VM_SSH_KEY. See docs/deploy.md.
